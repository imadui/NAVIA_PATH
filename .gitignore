# Credentials & secrets (NEVER commit real credentials)
credentials/*.json
credentials/**
!credentials/README.txt
!credentials/.gitkeep
config/providers/.env.*
!.env.*.example
!config/providers/.env.*.example
*.pem
*.pfx
*.key
application_default_credentials.json

# Runtime local utilisateur et logs
Runs/
Logs/
Cache/
EdgeProfile/
ChromeProfile/
*.log
*.tmp
*.bak
*.old
~*
.backup*/
result.json
trace.jsonl

# UiPath Studio artefacts locaux
uipath/**/.local/
uipath/**/.tmh/
uipath/**/.settings/
uipath/**/.screenshots/
uipath/**/.objects/
uipath/**/.project/
# preserve activity metadata json files
!uipath/**/*.xaml.json

# Fichiers temporaires Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
