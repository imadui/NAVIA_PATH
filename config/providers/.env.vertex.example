# Configuration for Google Vertex AI Provider
# Authentication: by default via Application Default Credentials
# Place your Google credentials JSON in credentials\vertex_credentials.json
# or login via: gcloud auth application-default login

NAVIA_PROVIDER=vertex
NAVIA_VERTEX_PROJECT=my-gcp-project
NAVIA_VERTEX_LOCATION=global
NAVIA_VERTEX_MODEL=gemini-3.8-flash
NAVIA_VERTEX_TIMEOUT_SECONDS=60
GOOGLE_APPLICATION_CREDENTIALS=credentials\vertex_credentials.json
