# Configuration for Google Vertex AI Provider
# Authentication: by default via Application Default Credentials (gcloud auth application-default login)
NAVIA_VERTEX_PROJECT=your-gcp-project-id
NAVIA_VERTEX_LOCATION=global
NAVIA_VERTEX_MODEL=gemini-3.8-flash
NAVIA_VERTEX_TIMEOUT_SECONDS=60
# Optional: path to service account JSON file if ADC is not used
# GOOGLE_APPLICATION_CREDENTIALS=
